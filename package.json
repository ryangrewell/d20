{
  "name": "d20",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:infra": "docker compose up -d",
    "dev:infra:down": "docker compose down",
    "dev:api": "tsx watch --clear-screen=false dev/server.ts",
    "dev:web": "vite",
    "seed": "tsx scripts/seed-demo.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit && tsc -p amplify/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.1",
    "@aws-amplify/backend-cli": "^1.10.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1157.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "aws-cdk-lib": "^2.275.0",
    "concurrently": "^10.0.6",
    "constructs": "^10.8.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-dynamodb": "^3.1157.0",
    "@aws-sdk/client-s3": "^3.1157.0",
    "@aws-sdk/credential-providers": "^3.1157.0",
    "@aws-sdk/lib-dynamodb": "^3.1157.0",
    "@aws-sdk/s3-request-presigner": "^3.1157.0",
    "@hono/node-server": "^2.1.5",
    "@radix-ui/react-dialog": "^1.3.1",
    "@smithy/signature-v4": "^5.7.4",
    "@tanstack/react-query": "^5.105.0",
    "aws-amplify": "^6.22.2",
    "clsx": "^2.1.1",
    "hono": "^4.13.14",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "ulid": "^3.0.2",
    "ws": "^8.22.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  }
}
